{
  "name": "mcp-notes",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.311",
    "@anthropic-ai/sdk": "0.135.0",
    "@hono/node-server": "2.1.5",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@neondatabase/serverless": "1.1.0",
    "chokidar": "6.0.0",
    "dotenv": "17.4.2",
    "drizzle-orm": "0.45.2",
    "exifr": "7.1.3",
    "file-type": "22.3.0",
    "heic-convert": "2.1.0",
    "hono": "4.13.14",
    "pg": "8.23.1",
    "sharp": "0.35.3",
    "ws": "8.22.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@fontsource-variable/host-grotesk": "5.3.0",
    "@fontsource/geist-mono": "5.3.0",
    "@phosphor-icons/react": "2.1.10",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/heic-convert": "2.1.1",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "6.1.2",
    "drizzle-kit": "0.31.10",
    "jsdom": "30.1.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "4.1.2"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "build:server": "tsc -p tsconfig.server.json",
    "build": "npm run build:server && npm run build:web",
    "build:web": "vite build --config web/vite.config.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:int": "bash scripts/test-int.sh",
    "test:live": "CHAT_LIVE_TEST=1 bash scripts/test-int.sh",
    "test:live:connectors": "CONNECTORS_LIVE_TEST=1 vitest run",
    "test:live:embeddings": "EMBEDDINGS_LIVE_TEST=1 vitest run",
    "test:live:imageEmbeddings": "IMAGE_EMBEDDINGS_LIVE_TEST=1 vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:check": "drizzle-kit check",
    "embed:backfill": "tsx src/cli/embedBackfill.ts",
    "embed:images:backfill": "tsx src/cli/embedImagesBackfill.ts"
  }
}
